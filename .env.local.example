# ---------- Navegador (públicas) ----------
# Supabase → botón "Connect" → pegá tal cual las dos líneas que te da
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------- Servidor (SECRETAS: sólo en .env.local / variables de Vercel, nunca en el código) ----------
# Sólo hacen falta para la facturación electrónica ARCA.
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...) o la service_role legacy
SUPABASE_SECRET_KEY=
# Certificado digital de ARCA y su clave privada. Se puede pegar el contenido PEM completo,
# con saltos de línea como \n, o el archivo codificado en base64 (base64 -w0 archivo).
ARCA_CERT=
ARCA_KEY=
