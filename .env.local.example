# ---------- Navegador (públicas) ----------
# Supabase → botón "Connect" → pegá tal cual las dos líneas que te da
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------- Servidor (SECRETA: sólo en .env.local / variables de Vercel, nunca en el código) ----------
# Hace falta para el cobro con QR de Mercado Pago y para la facturación electrónica ARCA.
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...) o la service_role legacy
SUPABASE_SECRET_KEY=

# Opcional / compatibilidad: certificado ARCA de una instalación de un solo comercio.
# Lo normal es que cada comercio lo cargue en Configuración → Facturación (queda cifrado en Supabase Vault).
ARCA_CERT=
ARCA_KEY=
